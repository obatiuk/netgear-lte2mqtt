# Required settings
MODEM_HOST=192.168.5.1
MODEM_PASSWORD=<your_admin_password>
MQTT_HOST=<mqtt_host>

# Optional MQTT settings
MQTT_TOPIC=netgear-lte2mqtt/state
MQTT_PUBLISH_INTERVAL=60
MQTT_PORT=1883
MQTT_CLIENT_ID=netgear-lte2mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CONNECTION_TIMEOUT=60
MQTT_MAX_RETRIES=5

# Optional MQTT TLS settings
MQTT_TLS=false
MQTT_VALIDATE_CERT=false
MQTT_CA_CERT_PATH=

# Optional logging settings (case-insensitive: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
